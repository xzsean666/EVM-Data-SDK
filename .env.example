# ==============================================================================
# EVM Data SDK - Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this template to `.env.key` (or `.env`) in your project or pass its path
# directly to the SDK:
#
#   const client = new EvmDataClient({
#     envFilePath: "./.env.key",
#     chainlink: { enabled: true },
#     defi: { enabled: true },
#   });
# ==============================================================================

# ==============================================================================
# 1. Multi-Chain Archive RPC API Keys (1 key automatically registers multiple chains)
# ==============================================================================

# NodeReal (MegaNode) - Automatically generates RPC endpoints for:
# Ethereum, Base, BSC, Polygon, Arbitrum, Optimism
NODEREAL_RPC_API_KEY1=your_nodereal_api_key_1
NODEREAL_RPC_API_KEY2=your_nodereal_api_key_2

# Ankr - Automatically generates RPC endpoints for:
# Ethereum, Base, BSC, Polygon, Arbitrum, Optimism
ANKR_RPC_API_KEY1=your_ankr_api_key_1
ANKR_RPC_API_KEY2=your_ankr_api_key_2

# Alchemy RPC - Automatically generates RPC endpoints for:
# Ethereum, Base, BSC, Polygon, Arbitrum, Optimism
ALCHEMY_RPC_API_KEY1=your_alchemy_rpc_key_1

# DRPC - Automatically generates RPC endpoints for:
# Ethereum, Base, BSC, Polygon, Arbitrum, Optimism
DRPC_RPC_API_KEY1=your_drpc_api_key_1

# Infura - Automatically generates RPC endpoints for:
# Ethereum, Base, Polygon, Arbitrum, Optimism
INFURA_RPC_API_KEY1=your_infura_api_key_1


# ==============================================================================
# 2. Direct Custom Chain RPC URLs (Optional)
# ==============================================================================
# Custom RPCs automatically merge into Chainlink, DeFi, and Uniswap Archive pools
ETHEREUM_RPC_URL1=https://eth-mainnet.example.com
BASE_RPC_URL1=https://base-mainnet.example.com
BSC_RPC_URL1=https://bsc-mainnet.example.com
POLYGON_RPC_URL1=https://polygon-mainnet.example.com
ARBITRUM_RPC_URL1=https://arbitrum-mainnet.example.com
OPTIMISM_RPC_URL1=https://optimism-mainnet.example.com


# ==============================================================================
# 3. Block Explorer & Indexer API Keys (Multi-key pooling supported)
# ==============================================================================

# Etherscan (Ethereum, Sepolia, Arbitrum, Optimism, Base, BSC, Polygon)
ETHERSCAN_API_KEY1=your_etherscan_api_key_1
ETHERSCAN_API_KEY2=your_etherscan_api_key_2

# Blockscout (Ethereum, Base)
BLOCKSCOUT_API_KEY1=your_blockscout_api_key_1

# Alchemy Data API (Indexed account / token transactions)
ALCHEMY_API_KEY1=your_alchemy_api_key_1

# Moralis (Historical balances, token metadata)
MORALIS_API_KEY1=your_moralis_api_key_1


# ==============================================================================
# 4. Proxy Configuration (HTTP/HTTPS / Sing-Box / VLESS)
# ==============================================================================
HTTP_PROXY=http://127.0.0.1:8080
# SING_BOX_URL=http://127.0.0.1:9090


# ==============================================================================
# 5. Database & Storage Configuration (SQLite / PostgreSQL)
# ==============================================================================
DATABASE_URL=sqlite:./data/evm-data-sdk.db
# DATABASE_URL=postgres://user:password@localhost:5432/evm_data
